<div class="container" style="margin: 100px auto">
    <div>
        {{#if error}}
        <h5>{{message}}</h5>
        {{/if}}
    </div>
    <div class="row">
        <div class="col-6 offset-3">
        <h1>Editar una novedad</h1>
        <form action="/admin/novedades/modificar" method="post">
            <h3>Novedad nro: {{novedad.id}}</h3>
            <input type="hidden" value="{{novedad.id}}" name="id">
            <div class="form-group">
                <input type="text" class="form-control" placeholder="Titulo" value="{{novedad.titulo}}" name="titulo">
            </div>
            <div class="form-group">
                <textarea type='text' class="form-control" placeholder="Subtitulo" name="subtitulo">{{novedad.subtitulo}}</textarea>
            </div>
            <div class="form-group">
                <textarea type='text' class="form-control" placeholder="Cuerpo" name="cuerpo">{{novedad.cuerpo}}</textarea>
            </div>
            <div class="form-group">
                <p>
                    <label>Imagen: <input type="file" name="imagen" id="imagen"/></label>
                </p>
                <p>
                    <label><input type="checkbox" name="img_delete" id="img_delete" value="1">Eliminar imagen actual?</label>
                    <input type="hidden" name="img_original" value="{{novedad.img_id}}">
                </p>
            </div>
            <button class="btn btn-success" href="/admin/novedades" type="submit">
                Guardar <i class="fa-solid fa-floppy-disk"></i>
            </button>
            <a href="/admin/novedades" class="btn btn-danger" >Cancelar<i class="fa fa-ban fa-fw"></i></a>
        </form>
        </div>
    </div>
</div>